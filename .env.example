# Dipakai oleh docker-compose.yml (variable substitution).
# Salin ke .env lalu sesuaikan, JANGAN commit .env.
SEWINGIOT_DB_SERVER=10.5.0.107
SEWINGIOT_DB_NAME=sewingiot
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=Satu1234!
# Origin yang diizinkan (WebSocket/CORS). "*" = semua. Pisahkan dgn koma utk membatasi.
