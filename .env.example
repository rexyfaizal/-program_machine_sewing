# Sync Master IE (detail-proses GCC)
GCC_BASE_URL=https://gcc.gistexgarmenindonesia.com
GCC_API_KEY=332100185
GCC_SMV_PAGE_LIMIT=50
GCC_SMV_HTTP_TIMEOUT_SEC=300
